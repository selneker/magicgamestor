# --- Base de données (nouvelle base MongoDB Atlas, vide au premier démarrage) ---
MONGO_URL=
DB_NAME=magicgamestore_prod

# --- Sécurité ---
JWT_SECRET=

# --- Administrateur initial (créé automatiquement par core/seed.py) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- URLs publiques ---
# URL canonique du frontend (redirections success/failure PAPI + CORS)
FRONTEND_URL=https://magicgame.store
# URL publique du backend FastAPI (webhook PAPI). Sur Render, RENDER_EXTERNAL_URL est utilisé en secours.
BACKEND_PUBLIC_URL=
# Liste séparée par des virgules. Jamais "*" en production.
CORS_ORIGINS=https://magicgame.store,https://www.magicgame.store

# --- Paiements ---
# simulation | papi
PAYMENT_MODE=simulation
PAPI_API_BASE=https://app.papi.mg/engine/api
PAPI_API_KEY=
PAPI_WEBHOOK_SECRET=
MVOLA_MERCHANT_MSISDN=
ORANGE_MERCHANT_NUMBER=
# Deadline métier interne d'une tentative de paiement (Papi validDuration reste en heures entières = 1h)
PAYMENT_TIMEOUT_MINUTES=15

# --- FazerCards (validation d'ID PUBG Mobile — Phase 1 ; commande fournisseur — Phase 3) ---
FAZERCARDS_API_BASE=https://api.fzr.cards/api/v2
FAZERCARDS_API_KEY=
# Secret webhook FazerCards (panneau reseller → Settings → Webhook). Vide = webhook rejeté.
FAZERCARDS_WEBHOOK_SECRET=

# --- Neferbyte (VÉRIFICATION d'ID/zone uniquement — le top-up reste FazerCards) ---
# Clé 32 caractères fournie par @idgamecheckerbot. Vide = vérification indisponible (503).
NEFERBYTE_API_BASE=https://api.neferbyte.com
NEFERBYTE_API_KEY=
# Timeout par tentative, en secondes (court : la vérification est sur le chemin du checkout).
NEFERBYTE_TIMEOUT_S=6
# Cache des SUCCÈS de vérification, en secondes (0 = cache désactivé). Seuls les `ok` sont
# mémorisés, en mémoire du processus ; un ID refusé ou une panne n'est jamais mis en cache.
NEFERBYTE_CACHE_TTL_S=600
# Plafond d'appels RÉELS par jour UTC (remis à zéro à 00:00 UTC). Vide = pas de plafond : le
# compteur tourne quand même (collection `neferbyte_quota`) et un avertissement est journalisé.
# Plafond atteint, ou réponse « daily limit » du fournisseur : plus aucun appel et résultat
# `provider_unavailable` jusqu'au lendemain — jamais une validation par défaut.
NEFERBYTE_DAILY_LIMIT=
# Secret du HMAC qui hache les clés de cache (aucun ID en clair en mémoire). À défaut,
# NEFERBYTE_API_KEY est utilisé ; sans aucun des deux, un sel public documenté s'applique.
NEFERBYTE_CACHE_SECRET=

# --- Anti-doublon multi-jeux (verrous d'identité : game_id + identity_key) ---
# on (défaut) : au démarrage, complète game_id/identity_key sur orders/subscription_locks/evo_locks,
# crée les index uniques (game_id, identity_key, …) puis supprime les index historiques (pubg_id, …)
# en dernier — et seulement si tout est en place. Purement additif et rejouable.
# off : aucune migration ; les index historiques restent seuls (protection inchangée).
IDENTITY_KEY_MIGRATION=on

# Taille de lot du backfill de la migration ci-dessus (nombre de documents par appel d'écriture).
# 500 par défaut : ~100 Ko par commande (limite Mongo 16 Mo) et 500 fois moins d'allers-retours.
# Bornée à 1..10 000 ; une valeur illisible retombe sur 500. 1 = une écriture par document.
IDENTITY_KEY_BACKFILL_BATCH=500

# --- Binance Exchange (CEX) — détection des dépôts USDT (TRC20/BEP20/APTOS/TON) ---
# Clé API en lecture seule UNIQUEMENT ("Enable Reading"). Ne jamais activer Withdrawals / Spot Trading.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_API_BASE=https://api.binance.com

# --- Anti-spam (valeurs par défaut raisonnables ; ajuster si besoin) ---
ORDERS_PER_HOUR_PER_IP=30
ORDERS_PER_HOUR_PER_USER=20
PAYMENT_INITIATE_PER_10MIN_PER_IP=15
PAYMENT_INITIATE_PER_10MIN_PER_USER=10
PAYMENT_RETRY_MIN_SECONDS=20
PAYMENT_MAX_ATTEMPTS=8
LOGIN_PER_10MIN_PER_IP=30
REGISTER_PER_HOUR_PER_IP=10
AUTH_EMAILS_PER_HOUR_PER_IP=10
FORGOT_PER_HOUR_PER_EMAIL=3
VERIFY_EMAILS_PER_HOUR=3
# IPs exemptées (ex: monitoring interne). Vide en production.
RATE_LIMIT_TRUSTED_IPS=

# --- Google OAuth (client OAuth Magic Game Store, Google Cloud Console) ---
# Redirect URI à déclarer : https://api.magicgame.store/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Emails transactionnels (Mailjet Send API v3.1 via HTTPS ; SMTP bloqué sur Render Free) ---
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=admin@magicgame.store
MAILJET_FROM_NAME=Magic Game Store

# --- Cookies partagés apex/api ---
COOKIE_DOMAIN=.magicgame.store

VAPID_PRIVATE_KEY_PEM=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=
PUSH_ENDPOINT_HOSTS=
