# --- Base de données (nouvelle base MongoDB Atlas, vide au premier démarrage) ---
MONGO_URL=
DB_NAME=magicgamestore_prod

# --- Sécurité ---
JWT_SECRET=

# --- Administrateur initial (créé automatiquement par core/seed.py) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- URLs publiques ---
# URL canonique du frontend (redirections success/failure PAPI + CORS)
FRONTEND_URL=https://magicgame.store
# URL publique du backend FastAPI (webhook PAPI). Sur Render, RENDER_EXTERNAL_URL est utilisé en secours.
BACKEND_PUBLIC_URL=
# Liste séparée par des virgules. Jamais "*" en production.
CORS_ORIGINS=https://magicgame.store,https://www.magicgame.store

# --- Paiements ---
# simulation | papi
PAYMENT_MODE=simulation
PAPI_API_BASE=https://app.papi.mg/engine/api
PAPI_API_KEY=
PAPI_WEBHOOK_SECRET=
MVOLA_MERCHANT_MSISDN=
ORANGE_MERCHANT_NUMBER=
# Deadline métier interne d'une tentative de paiement (Papi validDuration reste en heures entières = 1h)
PAYMENT_TIMEOUT_MINUTES=15

# --- FazerCards (validation d'ID PUBG Mobile — Phase 1) ---
FAZERCARDS_API_BASE=https://api.fzr.cards/api/v2
FAZERCARDS_API_KEY=

# --- Anti-spam (valeurs par défaut raisonnables ; ajuster si besoin) ---
ORDERS_PER_HOUR_PER_IP=30
ORDERS_PER_HOUR_PER_USER=20
PAYMENT_INITIATE_PER_10MIN_PER_IP=15
PAYMENT_INITIATE_PER_10MIN_PER_USER=10
PAYMENT_RETRY_MIN_SECONDS=20
PAYMENT_MAX_ATTEMPTS=8
LOGIN_PER_10MIN_PER_IP=30
REGISTER_PER_HOUR_PER_IP=10
AUTH_EMAILS_PER_HOUR_PER_IP=10
FORGOT_PER_HOUR_PER_EMAIL=3
VERIFY_EMAILS_PER_HOUR=3
# IPs exemptées (ex: monitoring interne). Vide en production.
RATE_LIMIT_TRUSTED_IPS=

# --- Google OAuth (client OAuth Magic Game Store, Google Cloud Console) ---
# Redirect URI à déclarer : https://api.magicgame.store/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Emails transactionnels (Mailjet Send API v3.1 via HTTPS ; SMTP bloqué sur Render Free) ---
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=admin@magicgame.store
MAILJET_FROM_NAME=Magic Game Store

# --- Cookies partagés apex/api ---
COOKIE_DOMAIN=.magicgame.store

VAPID_PRIVATE_KEY_PEM=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=
PUSH_ENDPOINT_HOSTS=
